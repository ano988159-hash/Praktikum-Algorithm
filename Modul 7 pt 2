
def ordinal(angka):
    if angka % 100 in [11, 12, 13]:
        akhiran = "th"
    elif angka % 10 == 1:
        akhiran = "st"
    elif angka % 10 == 2:
        akhiran = "nd"
    elif angka % 10 == 3:
        akhiran = "rd"
    else:
        akhiran = "th"

    return (angka, akhiran)


def program():
    print("Ordinal Number")
    print("ketik 0 untuk menghentikan program")

    while True:
        angka = int(input("masukkan angka: "))
        print(ordinal(angka))

        if angka == 0:
            break

    print("terima kasih telah menggunakan program saya")


program()
